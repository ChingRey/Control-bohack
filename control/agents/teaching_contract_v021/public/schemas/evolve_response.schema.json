{
  "$defs": {
    "ContentPolicy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "content_policy",
          "default": "content_policy",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "rules"
      ],
      "title": "ContentPolicy",
      "type": "object"
    },
    "ExperimentDesign": {
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "enum": [
            "A_B",
            "before_after",
            "paired_tasks"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "primary_metric": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Primary Metric",
          "type": "string"
        },
        "secondary_metrics": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Secondary Metrics",
          "type": "array"
        },
        "guardrails": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Guardrails",
          "type": "array"
        }
      },
      "required": [
        "comparison",
        "primary_metric",
        "guardrails"
      ],
      "title": "ExperimentDesign",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "when": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "When",
          "type": "string"
        },
        "action": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "when",
        "action"
      ],
      "title": "Rule",
      "type": "object"
    },
    "StrategyStep": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "enum": [
            "ask",
            "explain",
            "example",
            "practice",
            "hint",
            "feedback",
            "transfer"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "instruction": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        }
      },
      "required": [
        "action_type",
        "instruction"
      ],
      "title": "StrategyStep",
      "type": "object"
    },
    "TeachingStrategy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "teaching_strategy",
          "default": "teaching_strategy",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Capability Ids",
          "type": "array"
        },
        "learner_condition": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Learner Condition",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StrategyStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "capability_ids",
        "learner_condition",
        "steps",
        "stop_conditions"
      ],
      "title": "TeachingStrategy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.1",
      "default": "0.2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "proposal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Proposal Id",
      "type": "string"
    },
    "status": {
      "const": "candidate",
      "default": "candidate",
      "title": "Status",
      "type": "string"
    },
    "target_type": {
      "enum": [
        "content_policy",
        "teaching_strategy"
      ],
      "title": "Target Type",
      "type": "string"
    },
    "current_policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Current Policy Id",
      "type": "string"
    },
    "from_version": {
      "minimum": 1,
      "title": "From Version",
      "type": "integer"
    },
    "candidate_policy": {
      "discriminator": {
        "mapping": {
          "content_policy": "#/$defs/ContentPolicy",
          "teaching_strategy": "#/$defs/TeachingStrategy"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ContentPolicy"
        },
        {
          "$ref": "#/$defs/TeachingStrategy"
        }
      ],
      "title": "Candidate Policy"
    },
    "hypothesis": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Hypothesis",
      "type": "string"
    },
    "supporting_record_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Supporting Record Ids",
      "type": "array"
    },
    "expected_outcome": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Expected Outcome",
      "type": "string"
    },
    "failure_criteria": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Failure Criteria",
      "type": "array"
    },
    "experiment_design": {
      "$ref": "#/$defs/ExperimentDesign"
    }
  },
  "required": [
    "request_id",
    "proposal_id",
    "target_type",
    "current_policy_id",
    "from_version",
    "candidate_policy",
    "hypothesis",
    "supporting_record_ids",
    "expected_outcome",
    "failure_criteria",
    "experiment_design"
  ],
  "title": "EvolutionProposal",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control.example.invalid/contracts/v0.2.1/evolve_response.schema.json"
}
