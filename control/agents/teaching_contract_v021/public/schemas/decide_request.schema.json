{
  "$defs": {
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "behaviors": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Behaviors",
          "type": "array"
        },
        "prerequisite_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Prerequisite Capability Ids",
          "type": "array"
        },
        "knowledge_point_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Knowledge Point Ids",
          "type": "array"
        },
        "rubric_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rubric Id",
          "type": "string"
        },
        "skill_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill Id"
        }
      },
      "required": [
        "id",
        "title",
        "behaviors",
        "knowledge_point_ids",
        "rubric_id"
      ],
      "title": "Capability",
      "type": "object"
    },
    "ContentPolicy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "content_policy",
          "default": "content_policy",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "rules"
      ],
      "title": "ContentPolicy",
      "type": "object"
    },
    "CourseCatalog": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "knowledge_points": {
          "items": {
            "$ref": "#/$defs/KnowledgePoint"
          },
          "minItems": 1,
          "title": "Knowledge Points",
          "type": "array"
        },
        "rubrics": {
          "items": {
            "$ref": "#/$defs/Rubric"
          },
          "minItems": 1,
          "title": "Rubrics",
          "type": "array"
        }
      },
      "required": [
        "version",
        "capabilities",
        "knowledge_points",
        "rubrics"
      ],
      "title": "CourseCatalog",
      "type": "object"
    },
    "CourseSnapshot": {
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Catalog Version",
          "type": "string"
        },
        "candidate_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "title": "Candidate Capability Ids",
          "type": "array"
        },
        "target_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Capability Ids",
          "type": "array"
        },
        "completed_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Completed Capability Ids",
          "type": "array"
        }
      },
      "required": [
        "catalog_version",
        "candidate_capability_ids"
      ],
      "title": "CourseSnapshot",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "max_score": {
          "exclusiveMinimum": 0,
          "title": "Max Score",
          "type": "number"
        }
      },
      "required": [
        "id",
        "description",
        "max_score"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "project",
            "learner",
            "assessment",
            "interaction"
          ],
          "title": "Source",
          "type": "string"
        },
        "kind": {
          "enum": [
            "plan",
            "code_diff",
            "runtime",
            "test",
            "student_message",
            "evaluation",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Ref"
        }
      },
      "required": [
        "id",
        "source",
        "kind",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "HistorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "recent_decision_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Recent Decision Ids",
          "type": "array"
        },
        "recent_evaluation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Recent Evaluation Ids",
          "type": "array"
        }
      },
      "title": "HistorySnapshot",
      "type": "object"
    },
    "KnowledgePoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "title": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "prerequisites": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "project_stages": {
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "minItems": 1,
          "title": "Project Stages",
          "type": "array"
        }
      },
      "required": [
        "id",
        "capability_id",
        "title",
        "project_stages"
      ],
      "title": "KnowledgePoint",
      "type": "object"
    },
    "KnowledgeState": {
      "additionalProperties": false,
      "properties": {
        "knowledge_point_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Knowledge Point Id",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Mastery"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "knowledge_point_id",
        "level"
      ],
      "title": "KnowledgeState",
      "type": "object"
    },
    "LearnerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "student_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Student Id",
          "type": "string"
        },
        "knowledge_states": {
          "items": {
            "$ref": "#/$defs/KnowledgeState"
          },
          "title": "Knowledge States",
          "type": "array"
        },
        "prior_help_count": {
          "default": 0,
          "minimum": 0,
          "title": "Prior Help Count",
          "type": "integer"
        }
      },
      "required": [
        "student_id"
      ],
      "title": "LearnerSnapshot",
      "type": "object"
    },
    "Mastery": {
      "enum": [
        "unassessed",
        "needs_support",
        "guided",
        "independent",
        "transfer_verified"
      ],
      "title": "Mastery",
      "type": "string"
    },
    "ProjectSnapshot": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "goal": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "task_id",
        "goal"
      ],
      "title": "ProjectSnapshot",
      "type": "object"
    },
    "Rubric": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "pass_score": {
          "minimum": 0,
          "title": "Pass Score",
          "type": "number"
        }
      },
      "required": [
        "id",
        "version",
        "capability_id",
        "criteria",
        "pass_score"
      ],
      "title": "Rubric",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "when": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "When",
          "type": "string"
        },
        "action": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "when",
        "action"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Stage": {
      "enum": [
        "planning",
        "implementation",
        "debugging",
        "verification"
      ],
      "title": "Stage",
      "type": "string"
    },
    "TeachingContext": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "checkpoint_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Checkpoint Id",
          "type": "string"
        },
        "project": {
          "$ref": "#/$defs/ProjectSnapshot"
        },
        "learner": {
          "$ref": "#/$defs/LearnerSnapshot"
        },
        "course": {
          "$ref": "#/$defs/CourseSnapshot"
        },
        "history": {
          "$ref": "#/$defs/HistorySnapshot"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "context_id",
        "session_id",
        "checkpoint_id",
        "project",
        "learner",
        "course"
      ],
      "title": "TeachingContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.1",
      "default": "0.2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/TeachingContext"
    },
    "catalog": {
      "$ref": "#/$defs/CourseCatalog"
    },
    "content_policy": {
      "$ref": "#/$defs/ContentPolicy"
    }
  },
  "required": [
    "request_id",
    "context",
    "catalog",
    "content_policy"
  ],
  "title": "DecideRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control.example.invalid/contracts/v0.2.1/decide_request.schema.json"
}
