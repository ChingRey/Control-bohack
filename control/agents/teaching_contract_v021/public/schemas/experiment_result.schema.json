{
  "$defs": {
    "ExperimentObservation": {
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "policy_version": {
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "baseline_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Score"
        },
        "transfer_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transfer Score"
        },
        "hint_count": {
          "minimum": 0,
          "title": "Hint Count",
          "type": "integer"
        },
        "incomplete": {
          "default": false,
          "title": "Incomplete",
          "type": "boolean"
        },
        "evaluation_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evaluation Refs",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "policy_version",
        "hint_count"
      ],
      "title": "ExperimentObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "proposal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Proposal Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "insufficient_evidence",
        "validated",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "current_policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Current Policy Id",
      "type": "string"
    },
    "from_version": {
      "minimum": 1,
      "title": "From Version",
      "type": "integer"
    },
    "candidate_version": {
      "minimum": 1,
      "title": "Candidate Version",
      "type": "integer"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ExperimentObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "decision_reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Decision Reason",
      "type": "string"
    }
  },
  "required": [
    "proposal_id",
    "status",
    "current_policy_id",
    "from_version",
    "candidate_version",
    "decision_reason"
  ],
  "title": "ExperimentResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control.example.invalid/contracts/v0.2.1/experiment_result.schema.json"
}
