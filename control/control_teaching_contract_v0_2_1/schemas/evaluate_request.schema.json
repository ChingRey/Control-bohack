{
  "$defs": {
    "CourseSnapshot": {
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Catalog Version",
          "type": "string"
        },
        "candidate_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "title": "Candidate Capability Ids",
          "type": "array"
        },
        "target_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Capability Ids",
          "type": "array"
        },
        "completed_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Completed Capability Ids",
          "type": "array"
        }
      },
      "required": [
        "catalog_version",
        "candidate_capability_ids"
      ],
      "title": "CourseSnapshot",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "max_score": {
          "exclusiveMinimum": 0,
          "title": "Max Score",
          "type": "number"
        }
      },
      "required": [
        "id",
        "description",
        "max_score"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "project",
            "learner",
            "assessment",
            "interaction"
          ],
          "title": "Source",
          "type": "string"
        },
        "kind": {
          "enum": [
            "plan",
            "code_diff",
            "runtime",
            "test",
            "student_message",
            "evaluation",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Ref"
        }
      },
      "required": [
        "id",
        "source",
        "kind",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "HistorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "recent_decision_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Recent Decision Ids",
          "type": "array"
        },
        "recent_evaluation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Recent Evaluation Ids",
          "type": "array"
        }
      },
      "title": "HistorySnapshot",
      "type": "object"
    },
    "KnowledgeState": {
      "additionalProperties": false,
      "properties": {
        "knowledge_point_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Knowledge Point Id",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Mastery"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "knowledge_point_id",
        "level"
      ],
      "title": "KnowledgeState",
      "type": "object"
    },
    "LearnerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "student_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Student Id",
          "type": "string"
        },
        "knowledge_states": {
          "items": {
            "$ref": "#/$defs/KnowledgeState"
          },
          "title": "Knowledge States",
          "type": "array"
        },
        "prior_help_count": {
          "default": 0,
          "minimum": 0,
          "title": "Prior Help Count",
          "type": "integer"
        }
      },
      "required": [
        "student_id"
      ],
      "title": "LearnerSnapshot",
      "type": "object"
    },
    "Mastery": {
      "enum": [
        "unassessed",
        "needs_support",
        "guided",
        "independent",
        "transfer_verified"
      ],
      "title": "Mastery",
      "type": "string"
    },
    "ProjectSnapshot": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "goal": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "task_id",
        "goal"
      ],
      "title": "ProjectSnapshot",
      "type": "object"
    },
    "Rubric": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "pass_score": {
          "minimum": 0,
          "title": "Pass Score",
          "type": "number"
        }
      },
      "required": [
        "id",
        "version",
        "capability_id",
        "criteria",
        "pass_score"
      ],
      "title": "Rubric",
      "type": "object"
    },
    "Stage": {
      "enum": [
        "planning",
        "implementation",
        "debugging",
        "verification"
      ],
      "title": "Stage",
      "type": "string"
    },
    "StudentMessage": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "content": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "content"
      ],
      "title": "StudentMessage",
      "type": "object"
    },
    "TeachingContext": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "checkpoint_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Checkpoint Id",
          "type": "string"
        },
        "project": {
          "$ref": "#/$defs/ProjectSnapshot"
        },
        "learner": {
          "$ref": "#/$defs/LearnerSnapshot"
        },
        "course": {
          "$ref": "#/$defs/CourseSnapshot"
        },
        "history": {
          "$ref": "#/$defs/HistorySnapshot"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "context_id",
        "session_id",
        "checkpoint_id",
        "project",
        "learner",
        "course"
      ],
      "title": "TeachingContext",
      "type": "object"
    },
    "TeachingDecision": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.2.1",
          "default": "0.2.1",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "context_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "teach": {
          "title": "Teach",
          "type": "boolean"
        },
        "capability_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capability Id"
        },
        "knowledge_point_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Knowledge Point Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "objective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective"
        },
        "content_policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Content Policy Id",
          "type": "string"
        },
        "content_policy_version": {
          "minimum": 1,
          "title": "Content Policy Version",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "decision_id",
        "context_id",
        "teach",
        "capability_id",
        "reason",
        "content_policy_id",
        "content_policy_version"
      ],
      "title": "TeachingDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.1",
      "default": "0.2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/TeachingContext"
    },
    "decision": {
      "$ref": "#/$defs/TeachingDecision"
    },
    "turn_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Turn Id",
      "type": "string"
    },
    "assessment_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "assessment_mode": {
      "enum": [
        "formative",
        "independent_transfer"
      ],
      "title": "Assessment Mode",
      "type": "string"
    },
    "rubric": {
      "$ref": "#/$defs/Rubric"
    },
    "student_response": {
      "$ref": "#/$defs/StudentMessage"
    },
    "assessment_task_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Assessment Task Id",
      "type": "string"
    },
    "assessment_reference": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Assessment Reference",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "context",
    "decision",
    "turn_id",
    "assessment_id",
    "assessment_mode",
    "rubric",
    "student_response",
    "assessment_task_id",
    "assessment_reference"
  ],
  "title": "EvaluateRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control.example.invalid/contracts/v0.2.1/evaluate_request.schema.json"
}
