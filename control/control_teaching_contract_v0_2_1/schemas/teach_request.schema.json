{
  "$defs": {
    "CourseSnapshot": {
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Catalog Version",
          "type": "string"
        },
        "candidate_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "title": "Candidate Capability Ids",
          "type": "array"
        },
        "target_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Capability Ids",
          "type": "array"
        },
        "completed_capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Completed Capability Ids",
          "type": "array"
        }
      },
      "required": [
        "catalog_version",
        "candidate_capability_ids"
      ],
      "title": "CourseSnapshot",
      "type": "object"
    },
    "CriterionFeedback": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "max_score": {
          "exclusiveMinimum": 0,
          "title": "Max Score",
          "type": "number"
        }
      },
      "required": [
        "criterion_id",
        "score",
        "max_score"
      ],
      "title": "CriterionFeedback",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "project",
            "learner",
            "assessment",
            "interaction"
          ],
          "title": "Source",
          "type": "string"
        },
        "kind": {
          "enum": [
            "plan",
            "code_diff",
            "runtime",
            "test",
            "student_message",
            "evaluation",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Ref"
        }
      },
      "required": [
        "id",
        "source",
        "kind",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "HistorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "recent_decision_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Recent Decision Ids",
          "type": "array"
        },
        "recent_evaluation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Recent Evaluation Ids",
          "type": "array"
        }
      },
      "title": "HistorySnapshot",
      "type": "object"
    },
    "KnowledgePackage": {
      "additionalProperties": false,
      "properties": {
        "knowledge_point_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Knowledge Point Id",
          "type": "string"
        },
        "concepts": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Concepts",
          "type": "array"
        },
        "examples": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Examples",
          "type": "array"
        },
        "misconceptions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Misconceptions",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "knowledge_point_id",
        "concepts"
      ],
      "title": "KnowledgePackage",
      "type": "object"
    },
    "KnowledgeState": {
      "additionalProperties": false,
      "properties": {
        "knowledge_point_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Knowledge Point Id",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Mastery"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "knowledge_point_id",
        "level"
      ],
      "title": "KnowledgeState",
      "type": "object"
    },
    "LearnerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "student_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Student Id",
          "type": "string"
        },
        "knowledge_states": {
          "items": {
            "$ref": "#/$defs/KnowledgeState"
          },
          "title": "Knowledge States",
          "type": "array"
        },
        "prior_help_count": {
          "default": 0,
          "minimum": 0,
          "title": "Prior Help Count",
          "type": "integer"
        }
      },
      "required": [
        "student_id"
      ],
      "title": "LearnerSnapshot",
      "type": "object"
    },
    "Mastery": {
      "enum": [
        "unassessed",
        "needs_support",
        "guided",
        "independent",
        "transfer_verified"
      ],
      "title": "Mastery",
      "type": "string"
    },
    "ProjectSnapshot": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "goal": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "task_id",
        "goal"
      ],
      "title": "ProjectSnapshot",
      "type": "object"
    },
    "RecordedEvaluation": {
      "additionalProperties": false,
      "description": "历史形成性/迁移评价精简快照，保留教学自适应所需信息。",
      "properties": {
        "evaluation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "assessment_mode": {
          "enum": [
            "formative",
            "independent_transfer"
          ],
          "title": "Assessment Mode",
          "type": "string"
        },
        "rubric_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rubric Id",
          "type": "string"
        },
        "rubric_version": {
          "minimum": 1,
          "title": "Rubric Version",
          "type": "integer"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/CriterionFeedback"
          },
          "title": "Criteria",
          "type": "array"
        },
        "proposed_mastery_level": {
          "$ref": "#/$defs/Mastery"
        },
        "knowledge_gaps": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Knowledge Gaps",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "next_recommendation": {
          "enum": [
            "continue_teaching",
            "begin_transfer",
            "finish_lesson",
            "needs_review"
          ],
          "title": "Next Recommendation",
          "type": "string"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "evaluation_id",
        "decision_id",
        "turn_id",
        "assessment_mode",
        "rubric_id",
        "rubric_version",
        "proposed_mastery_level",
        "confidence",
        "next_recommendation",
        "reason"
      ],
      "title": "RecordedEvaluation",
      "type": "object"
    },
    "RecordedTeachingTurn": {
      "additionalProperties": false,
      "description": "已执行并由后端持久化的教学动作；不包含未来步骤。",
      "properties": {
        "turn_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "turn_index": {
          "minimum": 0,
          "title": "Turn Index",
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/TeachPhase"
        },
        "strategy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Strategy Id",
          "type": "string"
        },
        "strategy_version": {
          "minimum": 1,
          "title": "Strategy Version",
          "type": "integer"
        },
        "action": {
          "$ref": "#/$defs/TeachingAction"
        },
        "student_reply": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudentMessage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evaluation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evaluation Ids",
          "type": "array"
        }
      },
      "required": [
        "turn_id",
        "decision_id",
        "turn_index",
        "phase",
        "strategy_id",
        "strategy_version",
        "action"
      ],
      "title": "RecordedTeachingTurn",
      "type": "object"
    },
    "Stage": {
      "enum": [
        "planning",
        "implementation",
        "debugging",
        "verification"
      ],
      "title": "Stage",
      "type": "string"
    },
    "StrategyRef": {
      "additionalProperties": false,
      "description": "后端记录的当前有效策略分配；模型不得自行构造权限或发布版本。",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "StrategyRef",
      "type": "object"
    },
    "StrategyStep": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "enum": [
            "ask",
            "explain",
            "example",
            "practice",
            "hint",
            "feedback",
            "transfer"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "instruction": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        }
      },
      "required": [
        "action_type",
        "instruction"
      ],
      "title": "StrategyStep",
      "type": "object"
    },
    "StudentMessage": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "content": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "content"
      ],
      "title": "StudentMessage",
      "type": "object"
    },
    "TeachPhase": {
      "enum": [
        "diagnosis",
        "knowledge_teaching",
        "guided_practice",
        "transfer_assessment",
        "summary"
      ],
      "title": "TeachPhase",
      "type": "string"
    },
    "TeachingAction": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ask",
            "explain",
            "example",
            "practice",
            "hint",
            "feedback",
            "transfer"
          ],
          "title": "Type",
          "type": "string"
        },
        "content": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "knowledge_point_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Knowledge Point Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "hint_level": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint Level"
        }
      },
      "required": [
        "type",
        "content",
        "knowledge_point_ids"
      ],
      "title": "TeachingAction",
      "type": "object"
    },
    "TeachingContext": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "checkpoint_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Checkpoint Id",
          "type": "string"
        },
        "project": {
          "$ref": "#/$defs/ProjectSnapshot"
        },
        "learner": {
          "$ref": "#/$defs/LearnerSnapshot"
        },
        "course": {
          "$ref": "#/$defs/CourseSnapshot"
        },
        "history": {
          "$ref": "#/$defs/HistorySnapshot"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "context_id",
        "session_id",
        "checkpoint_id",
        "project",
        "learner",
        "course"
      ],
      "title": "TeachingContext",
      "type": "object"
    },
    "TeachingDecision": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.2.1",
          "default": "0.2.1",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "context_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "teach": {
          "title": "Teach",
          "type": "boolean"
        },
        "capability_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capability Id"
        },
        "knowledge_point_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Knowledge Point Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "objective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective"
        },
        "content_policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Content Policy Id",
          "type": "string"
        },
        "content_policy_version": {
          "minimum": 1,
          "title": "Content Policy Version",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "decision_id",
        "context_id",
        "teach",
        "capability_id",
        "reason",
        "content_policy_id",
        "content_policy_version"
      ],
      "title": "TeachingDecision",
      "type": "object"
    },
    "TeachingHistory": {
      "additionalProperties": false,
      "description": "当前教学决策的最近已执行回合，输入快照由基础流程组提供。",
      "properties": {
        "recent_turns": {
          "items": {
            "$ref": "#/$defs/RecordedTeachingTurn"
          },
          "maxItems": 20,
          "title": "Recent Turns",
          "type": "array"
        },
        "recent_evaluations": {
          "items": {
            "$ref": "#/$defs/RecordedEvaluation"
          },
          "maxItems": 10,
          "title": "Recent Evaluations",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "summary_evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Summary Evidence Refs",
          "type": "array"
        }
      },
      "title": "TeachingHistory",
      "type": "object"
    },
    "TeachingStrategy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "teaching_strategy",
          "default": "teaching_strategy",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Capability Ids",
          "type": "array"
        },
        "learner_condition": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Learner Condition",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StrategyStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "capability_ids",
        "learner_condition",
        "steps",
        "stop_conditions"
      ],
      "title": "TeachingStrategy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.1",
      "default": "0.2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/TeachingContext"
    },
    "decision": {
      "$ref": "#/$defs/TeachingDecision"
    },
    "phase": {
      "$ref": "#/$defs/TeachPhase"
    },
    "turn_index": {
      "minimum": 0,
      "title": "Turn Index",
      "type": "integer"
    },
    "strategy_candidates": {
      "items": {
        "$ref": "#/$defs/TeachingStrategy"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Strategy Candidates",
      "type": "array"
    },
    "active_strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/StrategyRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "allow_strategy_switch": {
      "default": false,
      "title": "Allow Strategy Switch",
      "type": "boolean"
    },
    "teaching_history": {
      "$ref": "#/$defs/TeachingHistory"
    },
    "knowledge_packages": {
      "items": {
        "$ref": "#/$defs/KnowledgePackage"
      },
      "minItems": 1,
      "title": "Knowledge Packages",
      "type": "array"
    },
    "last_student_message": {
      "anyOf": [
        {
          "$ref": "#/$defs/StudentMessage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "latest_evaluation_id": {
      "anyOf": [
        {
