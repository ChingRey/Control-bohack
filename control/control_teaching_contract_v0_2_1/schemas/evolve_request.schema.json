{
  "$defs": {
    "ContentPolicy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "content_policy",
          "default": "content_policy",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "rules"
      ],
      "title": "ContentPolicy",
      "type": "object"
    },
    "Mastery": {
      "enum": [
        "unassessed",
        "needs_support",
        "guided",
        "independent",
        "transfer_verified"
      ],
      "title": "Mastery",
      "type": "string"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "when": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "When",
          "type": "string"
        },
        "action": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "when",
        "action"
      ],
      "title": "Rule",
      "type": "object"
    },
    "StrategyStep": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "enum": [
            "ask",
            "explain",
            "example",
            "practice",
            "hint",
            "feedback",
            "transfer"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "instruction": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        }
      },
      "required": [
        "action_type",
        "instruction"
      ],
      "title": "StrategyStep",
      "type": "object"
    },
    "TeachingOutcome": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "session_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "applied_policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Applied Policy Id",
          "type": "string"
        },
        "applied_policy_version": {
          "minimum": 1,
          "title": "Applied Policy Version",
          "type": "integer"
        },
        "baseline_level": {
          "$ref": "#/$defs/Mastery"
        },
        "final_level": {
          "$ref": "#/$defs/Mastery"
        },
        "hint_count": {
          "minimum": 0,
          "title": "Hint Count",
          "type": "integer"
        },
        "transfer_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transfer Passed"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "session_id",
        "capability_id",
        "applied_policy_id",
        "applied_policy_version",
        "baseline_level",
        "final_level",
        "hint_count",
        "evidence_refs"
      ],
      "title": "TeachingOutcome",
      "type": "object"
    },
    "TeachingStrategy": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "teaching_strategy",
          "default": "teaching_strategy",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "capability_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Capability Ids",
          "type": "array"
        },
        "learner_condition": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Learner Condition",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StrategyStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Stop Conditions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "capability_ids",
        "learner_condition",
        "steps",
        "stop_conditions"
      ],
      "title": "TeachingStrategy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.1",
      "default": "0.2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "current_policy": {
      "discriminator": {
        "mapping": {
          "content_policy": "#/$defs/ContentPolicy",
          "teaching_strategy": "#/$defs/TeachingStrategy"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ContentPolicy"
        },
        {
          "$ref": "#/$defs/TeachingStrategy"
        }
      ],
      "title": "Current Policy"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/TeachingOutcome"
      },
      "minItems": 1,
      "title": "History",
      "type": "array"
    },
    "frozen_catalog_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Frozen Catalog Version",
      "type": "string"
    },
    "evaluation_rubric_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evaluation Rubric Ids",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "current_policy",
    "history",
    "frozen_catalog_version",
    "evaluation_rubric_ids"
  ],
  "title": "EvolveRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control.example.invalid/contracts/v0.2.1/evolve_request.schema.json"
}
