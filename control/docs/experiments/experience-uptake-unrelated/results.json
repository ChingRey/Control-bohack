      "files": {
        "app.js": "// 示例天气数据（北京）\nconst weatherData = {\n    city: \"北京\",\n    temperature: 22,\n    description: \"晴转多云\",\n    icon: \"⛅\", // 使用 emoji 作为天气图标\n    humidity: \"45%\",\n    wind: \"东北风 3级\"\n};\n\n// 渲染函数\nfunction renderWeather(data) {\n    const appContainer = document.getElementById('weather-app');\n\n    appContainer.innerHTML = `\n        <div class=\"city-name\">${data.city}</div>\n        <div class=\"weather-icon\">${data.icon}</div>\n        <p class=\"temperature\">${data.temperature}°C</p>\n        <p class=\"description\">${data.description}</p>\n        <div class=\"details\">\n            <div class=\"detail-item\">\n                <span>湿度</span>\n                ${data.humidity}\n            </div>\n            <div class=\"detail-item\">\n                <span>风力</span>\n                ${data.wind}\n            </div>\n        </div>\n    `;\n}\n\n// 页面加载完成后执行渲染\ndocument.addEventListener('DOMContentLoaded', () => {\n    renderWeather(weatherData);\n});\n",
        "index.html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>北京天气展示</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <div id=\"weather-app\" class=\"container\">\n        <!-- 天气信息将通过 JS 渲染在这里 -->\n    </div>\n\n    <script src=\"app.js\"></script>\n</body>\n</html>\n",
        "style.css": "body {\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    background: linear-gradient(135deg, #74ebd5, #ACB6E5);\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    height: 100vh;\n    margin: 0;\n    color: #333;\n}\n\n.container {\n    background: rgba(255, 255, 255, 0.85);\n    padding: 2rem;\n    border-radius: 20px;\n    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);\n    text-align: center;\n    width: 300px;\n}\n\n.city-name {\n    font-size: 1.5rem;\n    font-weight: bold;\n    margin-bottom: 0.5rem;\n}\n\n.weather-icon {\n    font-size: 4rem;\n    margin: 1rem 0;\n}\n\n.temperature {\n    font-size: 3rem;\n    font-weight: 300;\n    margin: 0;\n}\n\n.description {\n    font-size: 1.1rem;\n    color: #555;\n    margin-bottom: 1.5rem;\n}\n\n.details {\n    display: flex;\n    justify-content: space-between;\n    border-top: 1px solid #ddd;\n    padding-top: 1rem;\n}\n\n.detail-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    font-size: 0.9rem;\n}\n\n.detail-item span {\n    font-weight: bold;\n    color: #444;\n}\n"
